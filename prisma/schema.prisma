// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  NA
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  role          Role         @default(MEMBER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assignedDeals DealLead[]
  updates       DealUpdate[]
}

model DealUpdate {
  id         String   @id @default(cuid())
  dealId     String
  deal       DealLead @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String   @db.Text
  createdAt  DateTime @default(now())
}

model DealDocument {
  id           String         @id @default(cuid())
  dealId       String
  deal         DealLead       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category     String
  documentName String
  status       DocumentStatus @default(PENDING)
  fileUrl      String?
  uploadedAt   DateTime?
  updatedAt    DateTime       @updatedAt

  @@unique([dealId, documentName])
}


model ValuationReport {
  id               String   @id @default(cuid())
  website          String
  companyName      String?
  sector           String?
  revenue2025      Float
  preTaxProfit     Float
  ownerSalary      Float
  targetValuation  Float?
  targetDilution   Float?
  analysisResult   String   @db.Text
  valuationMin     Float?
  valuationMax     Float?
  readinessScore   Int?
  createdAt        DateTime @default(now())
}

model DealLead {
  id                    String   @id @default(cuid())
  founderName           String
  email                 String
  phone                 String?
  companyName           String
  website               String
  linkedin              String?
  revenue2025           Float?
  preTaxProfit          Float?
  
  // 5 Investment Deliverables
  pitchDeckUrl          String?
  pitchDeckFileName     String?
  infoMemoUrl           String?
  infoMemoFileName      String?
  financialModelUrl     String?
  financialModelFileName String?
  valuationReportUrl    String?
  valuationReportFileName String?
  videoPitchUrl         String?

  requestedServices     String[] @default([])
  status                String   @default("NEW")
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  assignedToId          String?
  assignedTo            User?    @relation(fields: [assignedToId], references: [id])
  updates               DealUpdate[]
  documents             DealDocument[]
}

